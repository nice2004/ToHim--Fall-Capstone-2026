{
  "expo": {
    "name": "ToHim",
    "slug": "Thim",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "thim",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nicetetahirwa.Thim",
      "buildNumber": "2",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "ToHim needs access to your microphone to record voice interactions.",
        "NSSpeechRecognitionUsageDescription": "ToHim uses speech recognition to process your voice input.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.nicetetahirwa.Thim",
      "versionCode": 1,
      "permissions": [
        "RECORD_AUDIO",
        "RECORD_AUDIO"
      ]
    },
    "web": {},
    "extra": {
      "apiBaseUrl": "https://tabbi.onrender.com/api",
      "eas": {
        "projectId": "090abdbe-eedc-4399-9e58-7c98894eb329"
      }
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "backgroundColor": "#ffffff",
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "owner": "thim-westmont-cs195",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/090abdbe-eedc-4399-9e58-7c98894eb329"
    }
  }
}
