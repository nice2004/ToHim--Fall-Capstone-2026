{
  "expo": {
    "name": "Tabbe",
    "slug": "tabbe",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "tabbe",
    "developmentClient": false,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.davidoyebade.tabbe",
      "buildNumber": "2",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Tabbe needs access to your microphone to record voice interactions.",
        "NSSpeechRecognitionUsageDescription": "Tabbe uses speech recognition to process your voice input.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.davidoyebade.tabbe",
      "versionCode": 1,
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {},
    "extra": {
      "eas": {
        "projectId": "d8ece90e-0438-4970-b5ff-79aaa8f96305"
      },
      "apiBaseUrl": "https://tabbi.onrender.com/api"
    },
    "plugins": [
      "expo-sqlite"
    ]
  }
}
